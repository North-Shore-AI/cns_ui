# CnsUi Environment Configuration Example
# Copy to .env and customize for your environment

# Database
DATABASE_URL=ecto://postgres:postgres@localhost/cns_ui_dev
POOL_SIZE=10

# Phoenix Server
PHX_HOST=localhost
PORT=4000
SECRET_KEY_BASE=your_secret_key_base_here

# Crucible API Integration
CRUCIBLE_API_URL=http://localhost:4100
CRUCIBLE_API_TOKEN=
CRUCIBLE_PUBSUB_NAME=CrucibleUI.PubSub

# Labeling Backend Mode
# Options: local (default) | anvil
LABELING_MODE=local

# Anvil Configuration (used when LABELING_MODE=anvil)
ANVIL_URL=http://localhost:4101
ANVIL_TENANT_ID=cns_ui

# Development Settings
PHX_SERVER=true
ECTO_IPV6=false
